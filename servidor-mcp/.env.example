# Modelo do servidor-mcp/.env, que o "npm start" carrega (--env-file-if-exists=.env).
# Copie para servidor-mcp/.env (está no .gitignore) e preencha. Nunca versione o valor real.

# Obrigatória: chave HMAC do requestState, em hex, com 64 dígitos ou mais (32 bytes).
# Gere com: python3 -c "import secrets; print(secrets.token_hex(32))"
# Use a MESMA chave ao reiniciar o servidor, senão um requestState emitido antes do restart é recusado.
REQUEST_STATE_SECRET=

# Opcionais (padrões entre parênteses):
# MCP_PORT=7301
# DADOS_DIR=../dados
# REQUEST_STATE_TTL_SECONDS=900
